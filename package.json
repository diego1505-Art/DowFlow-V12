{
  "name": "dowflow-desktop",
  "version": "12.0.0",
  "private": true,
  "author": "DowFlow",
  "description": "DowFlow desktop shell",
  "main": "electron/main.cjs",
  "scripts": {
    "electron": "node node_modules/electron/cli.js .",
    "electron:dist": "node node_modules/electron-builder/cli.js --win nsis"
  },
  "build": {
    "appId": "com.dowflow.desktop",
    "productName": "DowFlow",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "dowflow",
        "filter": [
          "*.py",
          "requirements.txt",
          "templates/**/*",
          "static/**/*",
          "url_expanders/**/*"
        ]
      }
    ],
    "asar": true
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  }
}
